{
  "name": "@sanity/export",
  "version": "6.2.1",
  "description": "Export Sanity documents and assets",
  "keywords": [
    "cms",
    "content",
    "export",
    "headless",
    "ndjson",
    "realtime",
    "sanity"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/export/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/export.git"
  },
  "bin": {
    "detect-corrupt": "./bin/detect-corrupt.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "get-it": "^9.5.1",
    "json-stream-stringify": "^3.1.6",
    "modern-tar": "^0.8.4",
    "obug": "^2.1.4",
    "p-queue": "^9.0.1"
  },
  "devDependencies": {
    "@sanity/client": "^7.13.1",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.15",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tar": "^7.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.12"
  }
}
